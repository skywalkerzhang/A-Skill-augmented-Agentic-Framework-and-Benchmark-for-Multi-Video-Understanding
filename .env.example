# Text-only planner (OpenAI-compatible API)
API_MODEL_NAME=gpt-5.2
API_BASE_URL=https://api.openai.com/v1
API_KEY=

# Video reader: local Hugging Face model path or remote OpenAI-compatible API
API_MODEL_NAME_VLM=Qwen/Qwen2.5-VL-7B-Instruct
VLM_USE_REMOTE=0
API_BASE_URL_VLM=
API_KEY_VLM=

# Temporal grounding defaults to the planner when omitted
API_MODEL_NAME_TEMPORAL_GROUNDING=
API_BASE_URL_TEMPORAL_GROUNDING=
API_KEY_TEMPORAL_GROUNDING=

# Retrieval models
BGE_M3_PATH=BAAI/bge-m3
MODEL_CACHE_DIR=./model_cache
ASR_CACHE_DIR=./model_cache/asr
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Runtime
CUDA_VISIBLE_DEVICES=0
MAX_DS_ROUND=10
TOPK=10
